{
  "name": "@local/dsh-mobile-bridge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Pairing-protected HTTP/SSE bridge that lets the Android client watch and drive live DSH sessions.",
  "exports": {
    ".": "./bridge.mjs",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "bridge.mjs",
    "logic.mjs",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
